{
  "name": "payguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/prepare-standalone.mjs",
    "postinstall": "prisma generate",
    "start": "prisma migrate deploy && HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "lint": "eslint",
    "test": "tsx --test src/lib/*.test.ts",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.575.0",
    "next": "^16.4.2",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
